+    choice: T,
+    choices: Collection<T>,
+    choiceToString: @Composable (T) -> String,
+    onChoiceChanged: (T) -> Unit,
+) {
+    var expanded by remember { mutableStateOf(false) }
+
+    ExposedDropdownMenuBox(
+        expanded = expanded,
+        onExpandedChange = { expanded = it },
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(8.dp)
