+    EmulatedUSBDeviceTabContent {
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Button(onClick = { showCreateDialog = true }) { Text(tr("Create")) }
+            Button(onClick = { showInstalledFigures = true }) { Text(tr("Manage list")) }
