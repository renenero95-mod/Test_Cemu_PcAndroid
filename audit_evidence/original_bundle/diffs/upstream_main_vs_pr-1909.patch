+
+		uint32 figureNumber = nsyshid::g_infinitybase.LoadFigure(buffer, std::forward<std::unique_ptr<FileStream>>(file), slot);
+		auto [figureSeries, figureName] = nsyshid::g_infinitybase.FindFigure(figureNumber);
