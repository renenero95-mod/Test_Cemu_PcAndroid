+        InfinityRow("Player One", 3)
+        InfinityRow("Player One Ability One", 4)
+        InfinityRow("Player One Ability Two", 5)
+        InfinityRow("Player Two", 6)
+        InfinityRow("Player Two Ability One", 7)
+        InfinityRow("Player Two Ability Two", 8)
