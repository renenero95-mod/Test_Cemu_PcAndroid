+			{
+				uint8 nal_unit_type = (nalHeaderByte >> 0) & 0x1f;
+				if (nal_unit_type == 1) // non-idr
+					return false;
+				else if (nal_unit_type == 5) // idr
+					return true;
+			}
+			else
+			{
+				cemu_assert_suspicious();
+				return false; // corrupted stream?
+			}
+		}
+		return false;
