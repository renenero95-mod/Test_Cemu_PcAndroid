+	bool IsIDRSlice(uint8* streamData, sint32 length)
+	{
+		NALInputBitstream nalStream(streamData, length);
+		RBSPInputBitstream rbspStream;
+		while (nalStream.getNextRBSP(rbspStream))
+		{
+			// parse NAL header
+			uint8 nalHeaderByte = rbspStream.readU8();
